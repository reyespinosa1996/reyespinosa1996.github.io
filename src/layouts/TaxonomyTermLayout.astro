---
import { getCollection, type CollectionEntry } from 'astro:content';
import { i18n as enI18n } from '../i18n/en';
import { i18n as esI18n } from '../i18n/es';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { langPrefix, postUrl, publishedEntries, slugifyTerm } from '../lib/content';
import { defaultDescription, type SchemaItem } from '../lib/seo';

interface Props {
  lang: 'en' | 'es';
  field: 'tags' | 'categories';
  /** Slug del término (URL). */
  termSlug: string;
  /** Término original, para mostrarlo como título. */
  term: string;
}

const { lang, field, termSlug, term } = Astro.props;
const i18n = lang === 'es' ? esI18n : enI18n;

const all = publishedEntries(await getCollection('posts'), lang);
const entries: CollectionEntry<'posts'>[] = all.filter((entry) =>
  entry.data[field].some((value) => slugifyTerm(value) === termSlug),
);

const label = field === 'tags' ? i18n.post.tags : i18n.post.categories;
const base = langPrefix(lang);
const canonical = `${base}/${field}/${encodeURIComponent(termSlug)}/`;
const breadcrumbs: SchemaItem[] = [
  { name: i18n.nav.home, url: `${base}/` },
  { name: label, url: `${base}/${field}/` },
  { name: term, url: canonical },
];
const itemList: SchemaItem[] = entries.map((entry) => ({
  name: entry.data.title,
  url: postUrl(entry),
}));
---

<BaseLayout
  title={`${term} · ${label}`}
  description={defaultDescription(lang, 'taxonomyTerm', term)}
  lang={lang}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  itemList={itemList}
  kind="list"
>
  <h1 class="section-title">{term}</h1>
  <p class="section-description">
    {label}: {term} ({entries.length})
  </p>

  <PostList entries={entries} />
</BaseLayout>
