---
import { getCollection, type CollectionEntry } from 'astro:content';
import { i18n as enI18n } from '../i18n/en';
import { i18n as esI18n } from '../i18n/es';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Pagination from '../components/Pagination.astro';
import { otherLang, postUrl, publishedEntries } from '../lib/content';
import { paginate, postsPageUrl } from '../lib/pagination';
import { defaultDescription, type SchemaItem } from '../lib/seo';

interface Props {
  lang: 'en' | 'es';
  /** Número de página (1 = ruta canónica). */
  page?: number;
}

const { lang, page = 1 } = Astro.props;
const i18n = lang === 'es' ? esI18n : enI18n;

const all = publishedEntries(await getCollection('posts'), lang);
const pages = paginate(all);
const totalPages = pages.length;
const entries: CollectionEntry<'posts'>[] = pages[page - 1] ?? [];

const canonical = postsPageUrl(lang, 1);
const translations = [{ lang: otherLang(lang), url: postsPageUrl(otherLang(lang), 1) }];
const breadcrumbs: SchemaItem[] = [
  { name: i18n.nav.home, url: `${lang === 'es' ? '/es' : ''}/` },
  { name: i18n.nav.posts, url: canonical },
];
const itemList: SchemaItem[] = all.map((entry) => ({
  name: entry.data.title,
  url: postUrl(entry),
}));
---

<BaseLayout
  title={i18n.nav.posts}
  description={defaultDescription(lang, 'postsIndex')}
  lang={lang}
  canonical={canonical}
  translations={translations}
  breadcrumbs={breadcrumbs}
  itemList={itemList}
  translationKey="blog-list"
  kind="list"
>
  <h1 class="section-title">{i18n.nav.posts}</h1>
  <PostList entries={entries} />
  <Pagination
    currentPage={page}
    totalPages={totalPages}
    urlForPage={(p) => postsPageUrl(lang, p)}
  />
</BaseLayout>
