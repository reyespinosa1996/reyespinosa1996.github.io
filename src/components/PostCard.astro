---
import type { CollectionEntry } from 'astro:content';
import { postUrl } from '../lib/content';

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { title, date, description, tags, cover, lang } = data;
---

<article class="post-card">
  <h2>
    <a href={postUrl(entry)}>{title}</a>
  </h2>
  <div class="post-meta">
    <time>{new Date(date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })}</time>
    {description && <span>·</span>}
    {description && <span>{description}</span>}
  </div>
  {cover && (
    <div class="post-cover">
      <img src={cover.image} alt={cover.alt} loading="lazy" />
      {cover.caption && <p style="font-size: 0.875rem; color: var(--muted); margin-top: 0.25rem;">{cover.caption}</p>}
    </div>
  )}
  {tags.length > 0 && (
    <div class="post-tags">
      {tags.map((tag) => (
        <span class="post-tag">{tag}</span>
      ))}
    </div>
  )}
</article>
