---
import { i18n } from '../../i18n/es';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox.astro';
---

  <BaseLayout
    title={i18n.search.label}
    description={i18n.siteDescription}
    lang="es"
    canonical="/es/search/"
    translations={[{ lang: 'en', url: '/search/' }]}
    kind="list"
  >
    <h1 class="section-title">{i18n.search.label}</h1>

    <SearchBox lang="es" />
  </BaseLayout>
