---
import { i18n } from '../i18n/en';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import { defaultDescription } from '../lib/seo';
---

  <BaseLayout
    title={i18n.search.label}
    description={defaultDescription('en', 'search')}
    lang="en"
    canonical="/search/"
    translations={[{ lang: 'es', url: '/es/search/' }]}
    kind="list"
    noindex
  >
    <h1 class="section-title">{i18n.search.label}</h1>

    <SearchBox lang="en" />
  </BaseLayout>
