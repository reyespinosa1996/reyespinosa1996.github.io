---
import { getCollection } from 'astro:content';
import TaxonomyTermLayout from '../../layouts/TaxonomyTermLayout.astro';
import { publishedEntries, taxonomyTerms } from '../../lib/content';

export async function getStaticPaths() {
  const entries = publishedEntries(await getCollection('posts'), 'en');
  const terms = taxonomyTerms(entries, 'tags');

  return terms.map((t) => ({
    params: { tag: t.slug },
    props: { term: t.term, termSlug: t.slug },
  }));
}

const { term, termSlug } = Astro.props;
---

  <TaxonomyTermLayout lang="en" field="tags" term={term} termSlug={termSlug} />
